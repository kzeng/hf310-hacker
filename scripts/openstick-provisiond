def page(title, body):
    return ("<!doctype html><html lang=zh-CN><head><meta charset=utf-8>"
            "<meta name=viewport content='width=device-width,initial-scale=1'>"
            "<title>%s</title><style>%s</style></head><body><main>%s</main></body></html>"
            % (html.escape(title), CSS, body)).encode("utf-8")


def render_index(message=""):
    rows, from_cache = scan_networks()

    opts = ["<option value=''>— 从下面选，或手动输入 —</option>"]
    listing = []
    for r in rows:
        opts.append("<option value='%s'>%s</option>"
                    % (html.escape(r["ssid"], quote=True),
                       html.escape("%s (%s dBm)" % (r["ssid"], r["signal"]))))
        listing.append("<div class=row><span>%s</span><span class=sig>%s dBm · %s</span></div>"
                       % (html.escape(r["ssid"]), r["signal"], html.escape(r["security"])))
    if not listing:
        listing.append("<div class=row><span>列表为空 —— 直接在上面手动输入 WiFi 名称和密码即可</span></div>")

    note = ""
    if from_cache and rows:
        note = ("<p class=hint warn>热点模式下无线网卡无法扫描，以上是启动时缓存的结果；"
                "若列表里没有你的网络，直接在下面手动输入 SSID 即可。</p>")

    msg = ""
    if message:
        cls = "ok" if message.startswith("✓") else "err"
        msg = "<p class='%s'>%s</p>" % (cls, html.escape(message))

    body = """
<h1>HF310 网络配置</h1>
<p class=sub>设备当前没有可用网络。填写要连接的 WiFi，连上后本热点会自动关闭。</p>
<div class=card>
  <form method=post action=/connect>
    <label>选择网络</label>
    <select onchange="document.getElementById('ssid').value=this.value">
      %s
    </select>
    <label>SSID（可手动输入）</label>
    <input id=ssid name=ssid placeholder="WiFi 名称" autocomplete=off required>
    <label>密码</label>
    <input name=password type=password placeholder="开放网络请留空" autocomplete=off>
    <label style="display:flex;align-items:center;gap:8px;color:#9aa3b2">
      <input type=checkbox name=hidden value=1 style="width:auto"> 隐藏网络
    </label>
    <button type=submit>连接</button>
    <p class=hint>连接成功后本热点会消失，设备会以新网络重新上线。</p>
  </form>
  %s
</div>
<div class=card>
  <label style="margin-top:0">附近的网络</label>
  %s
  %s
  <form method=post action=/rescan><button class=secondary type=submit>重新渲染列表</button></form>
</div>
""" % ("\n      ".join(opts), msg, "\n  ".join(listing), note)
    return page("HF310 配网", body)


LAST = {"ssid": "", "ok": None, "detail": ""}
_CONNECTING = {"until": 0.0}


def connecting():
    return time.time() < _CONNECTING["until"]


def connect_async(ssid, password, hidden):
    _CONNECTING["until"] = time.time() + 90

    def worker():
        rc, detail = connect_wifi(ssid, password, hidden)
        LAST.update(ssid=ssid, ok=(rc == 0), detail=detail)
        log("connect result ssid=%r rc=%s detail=%s"
            % (ssid, rc, detail.replace("\n", " | ")[:300]))
        if rc != 0:
            # 失败：立刻解除保护，让守护进程把热点拉回来
            _CONNECTING["until"] = 0.0
    threading.Thread(target=worker, daemon=True).start()


PENDING_HTML = """
<h1>正在连接…</h1>
<p class=sub>正在尝试连接 <b>%s</b>。热点可能几秒内就关闭，属正常现象。</p>
<div class=card>
  <p id=msg>连接中，请稍候…</p>
  <p class=err id=err></p>
  <p class=hint>热点消失 → 配网成功，改用新网络访问
    <a href="http://hf310.local/">http://hf310.local/</a><br>
    30 秒后热点还在 → 说明密码不对，可返回重试。</p>
  <a href="/">← 返回配置页</a>
</div>
<script>
let n = 0;
const t = setInterval(async () => {
  n++;
  try {
    const d = await (await fetch('/status', {cache: 'no-store'})).json();
    if (d.last && d.last.ok === false) {
      clearInterval(t);
      document.getElementById('msg').textContent = '连接失败。';
      document.getElementById('err').textContent = d.last.detail || '';
    }
  } catch (e) { /* 热点已关闭 = 大概率成功 */ }
  if (n > 20) clearInterval(t);
}, 2000);
</script>"""

PROBES = {
    "/generate_204", "/gen_204", "/hotspot-detect.html",
    "/library/test/success.html", "/success.txt", "/ncsi.txt",
    "/connecttest.txt", "/canonical.html", "/redirect",
}


class Handler(BaseHTTPRequestHandler):
    server_version = "hf310-provision/1.0"

    def log_message(self, fmt, *args):                          # noqa: A003
        log("%s %s" % (self.address_string(), fmt % args))

    def _send(self, code, body, ctype="text/html; charset=utf-8", extra=None):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def _redirect(self):
        host = (self.headers.get("Host") or "192.168.4.1").split(":")[0]
        self.send_response(302)
        self.send_header("Location", "http://%s/" % host)
        self.send_header("Content-Length", "0")
        self.end_headers()

    def do_GET(self):                                           # noqa: N802
        path = self.path.split("?")[0]
        if path in PROBES:
            log("captive probe %s -> redirect" % path)
            self._redirect()
            return
        if path == "/status":
            ap_up, uplink = net_state()
            body = ('{"ap":%s,"uplink":%s,"last":{"ssid":%s,"ok":%s,"detail":%s}}'
                    % ("true" if ap_up else "false",
                       "true" if uplink else "false",
                       json.dumps(LAST["ssid"]),
                       "null" if LAST["ok"] is None else ("true" if LAST["ok"] else "false"),
                       json.dumps(LAST["detail"]))).encode()
            self._send(200, body, "application/json")
            return
        self._send(200, render_index())

    def do_HEAD(self):                                          # noqa: N802
        self.do_GET()

    def do_POST(self):                                          # noqa: N802
        length = min(int(self.headers.get("Content-Length") or 0), 8192)
        raw = self.rfile.read(length).decode("utf-8", "replace")
        form = parse_qs(raw, keep_blank_values=True)
        path = self.path.split("?")[0]

        if path == "/rescan":
            # AP 模式下扫不到东西，这里只是重渲染（会尝试一次实时扫描）
            self._send(200, render_index())
            return

        if path != "/connect":
            self._send(404, b"not found")
            return

        ssid = (form.get("ssid") or [""])[0].strip()
        password = (form.get("password") or [""])[0]
        hidden = "1" in (form.get("hidden") or [])
        if not ssid:
            self._send(200, render_index("✗ SSID 不能为空"))
            return

        log("connect request ssid=%r hidden=%s" % (ssid, hidden))
        LAST.update(ssid=ssid, ok=None, detail="")
        connect_async(ssid, password, hidden)
        self._send(200, page("HF310 配网", PENDING_HTML % html.escape(ssid)))


def main():
    log("provisiond started, watching connection %r" % AP_CON)
    server = None
    last_ap_scan = 0.0
    last_uplink_scan = 0.0
    last_sta_attempt = 0.0
    sta_retry_used = 0
    grace_logged = False
    while True:
        try:
            ap_up, uplink = net_state()

            if uplink and ap_up:
                log("uplink present -> tearing down AP")
                run(["nmcli", "con", "down", AP_CON], timeout=60)
                ap_up = False
                sta_retry_used = 0
            elif not ap_up and not uplink and not connecting():
                up_for = uptime_seconds()
                if up_for < STARTUP_GRACE:
                    # 刚开机，NetworkManager 正在自动连，别抢射频
                    if not grace_logged:
                        log("boot grace: uptime %.0fs < %ds, waiting for NetworkManager"
                            % (up_for, STARTUP_GRACE))
                        grace_logged = True
                elif (sta_retry_used < STA_RETRY_MAX
                        and time.time() - last_sta_attempt > 60):
                    grace_logged = False
                    last_sta_attempt = time.time()
                    sta_retry_used += 1
                    if try_known_wifi():
                        sta_retry_used = 0
                        continue
                else:
                    grace_logged = False
                    # AP 模式下无法扫描，先把周围网络扫一遍再拉热点
                    try:
                        scan_networks(force=True)
                    except Exception as exc:                    # noqa: BLE001
                        log("pre-AP scan failed: %s" % exc)
                    # 扫描要好几秒，期间 NetworkManager 可能已经连上，
                    # 必须复查，否则会把刚建立的连接直接踢掉（这就是「重启后又要配网」的根因）
                    _, up_after_scan = net_state()
                    if up_after_scan:
                        log("uplink appeared during pre-AP scan -> skip AP")
                    else:
                        log("no uplink and no AP -> activating AP %r" % AP_CON)
                        rc, out, err = run(["nmcli", "con", "up", AP_CON], timeout=120)
                        if rc != 0:
                            log("AP activation failed rc=%s: %s"
                                % (rc, (out + err).strip()[:300]))
                        time.sleep(2)
                        ap_up = AP_CON in active_connections()

            # 有上行链路时（STA 模式）扫描是自由的，顺手刷新缓存
            if uplink and time.time() - last_uplink_scan > UPLINK_SCAN_INTERVAL:
                last_uplink_scan = time.time()
                try:
                    scan_networks(force=True)
                except Exception as exc:                        # noqa: BLE001
                    log("uplink scan failed: %s" % exc)

            # AP 模式自愈：没人连着时按退避重试已知 WiFi（比如开机时路由器还没起来）
            if (ap_up and not uplink and not connecting()
                    and sta_retry_used < STA_RETRY_MAX
                    and time.time() - last_sta_attempt
                    > min(STA_RETRY_BASE * (2 ** max(sta_retry_used - 1, 0)), 300)
                    and not station_connected()):
                last_sta_attempt = time.time()
                sta_retry_used += 1
                log("AP idle -> retry known wifi (attempt %d/%d)"
                    % (sta_retry_used, STA_RETRY_MAX))
                if try_known_wifi():
                    sta_retry_used = 0

            # AP 模式下缓存太少时，趁没有客户端连着，短暂拆热点扫一次再拉回来
            if (ap_up and not uplink
                    and time.time() - last_ap_scan > AP_SCAN_INTERVAL
                    and len(_scan_cache["rows"]) < 5
                    and not station_connected()):
                last_ap_scan = time.time()
                log("AP scan cache thin (%d) -> scan window" % len(_scan_cache["rows"]))
                run(["nmcli", "con", "down", AP_CON], timeout=60)
                time.sleep(3)
                try:
                    rows = scan_with_retries(attempts=3, gap=6)
                except Exception as exc:                        # noqa: BLE001
                    log("scan window failed: %s" % exc)
                    rows = []
                if rows:
                    _scan_cache.update(ts=time.time(), rows=rows, from_cache=False)
                    _save_cache(rows)
                    log("scan window ok: %d networks" % len(rows))
                run(["nmcli", "con", "up", AP_CON], timeout=120)

            if ap_up and server is None:
                try:
                    server = ThreadingHTTPServer(("0.0.0.0", PORT), Handler)
                except OSError as exc:
                    log("bind :%d failed: %s" % (PORT, exc))
                    server = None
                else:
                    threading.Thread(target=server.serve_forever, daemon=True).start()
                    log("AP active -> serving http://192.168.4.1/")
            elif not ap_up and server is not None:
                server.shutdown()
                server.server_close()
                server = None
                log("AP down -> stopped http server")

            write_state(ap_up, uplink)
        except Exception as exc:                                # noqa: BLE001
            log("loop error: %s" % exc)

        time.sleep(3)


if __name__ == "__main__":
    main()
