#!/usr/bin/env python3
"""HF310 配网服务 (captive portal)。

状态机：
  * 有上行链路（WiFi 客户端 / 蜂窝）  -> 关掉 AP，只留 mDNS + SSH
  * 没有上行链路                      -> 拉起 AP(192.168.4.1) 并开网页配网

注意：wcn36xx 在 AP 模式下不支持扫描（-95），
所以必须在拉起 AP 之前先把周围网络扫一次并缓存到磁盘，页面用缓存渲染。
"""
import html
import json
import os
import subprocess
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs

AP_CON = os.environ.get("AP_CON", "hotspot")
PORT = int(os.environ.get("PORT", "80"))
SCAN_TTL = 20
UPLINK_SCAN_INTERVAL = 600       # 有上行时每 10 分钟刷新一次扫描缓存
AP_SCAN_INTERVAL = 300           # AP 模式下最多每 5 分钟做一次「扫描窗口」
STARTUP_GRACE = 60               # 开机后先让 NetworkManager 自己连，别急着抢射频
STA_RETRY_BASE = 120             # AP 模式下重试已知 WiFi 的起始间隔（退避翻倍）
STA_RETRY_MAX = 100000            # effectively unlimited; keep retrying while AP is up
CACHE_FILE = "/var/lib/hf310/wifi-scan.json"
STATE_FILE = "/run/hf310/state.json"
LOG = "/var/log/openstick-provision.log"

_scan_lock = threading.Lock()
_scan_cache = {"ts": 0.0, "rows": [], "from_cache": False}
_ap_ssid = {"value": "Openstick"}


def log(msg):
    line = "%s %s" % (time.strftime("%Y-%m-%d %H:%M:%S"), msg)
    print(line, flush=True)
    try:
        with open(LOG, "a", encoding="utf-8") as f:
            f.write(line + "\n")
    except OSError:
        pass


def run(args, timeout=30):
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout, p.stderr
    except Exception as exc:                                    # noqa: BLE001
        return 1, "", str(exc)


def terse_split(line):
    """nmcli -t 用 '\\:' 转义冒号，这里按未转义的冒号切分。"""
    fields, cur, esc = [], [], False
    for ch in line:
        if esc:
            cur.append(ch)
            esc = False
        elif ch == "\\":
            esc = True
        elif ch == ":":
            fields.append("".join(cur))
            cur = []
        else:
            cur.append(ch)
    fields.append("".join(cur))
    return fields


def write_state(ap_up, uplink):
    """给 LED 守护进程看的状态文件（/run/hf310/state.json）。"""
    try:
        os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
        tmp = STATE_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump({"ap": bool(ap_up), "uplink": bool(uplink),
                       "connecting": connecting(), "ts": time.time()}, f)
        os.replace(tmp, STATE_FILE)
    except OSError as exc:
        log("state write failed: %s" % exc)


def active_connections():
    _, out, _ = run(["nmcli", "-t", "-f", "NAME", "con", "show", "--active"])
    return {ln for ln in out.splitlines() if ln}


def net_state():
    """返回 (AP 是否激活, 是否已有上行链路)。

    上行链路 = 已连上的 WiFi 客户端连接或蜂窝连接；usb0 共享链路不算。
    """
    _, out, _ = run(["nmcli", "-t", "-f", "NAME,TYPE", "con", "show", "--active"])
    ap, uplink = False, False
    for line in out.splitlines():
        name, _, ctype = line.partition(":")
        if name == AP_CON:
            ap = True
        elif ctype in ("802-11-wireless", "gsm", "cdma"):
            uplink = True
    return ap, uplink


def ap_ssid():
    if _ap_ssid["value"] == "Openstick":
        rc, out, _ = run(["nmcli", "-g", "802-11-wireless.ssid", "con", "show", AP_CON])
        if rc == 0 and out.strip():
            _ap_ssid["value"] = out.strip()
    return _ap_ssid["value"]


def _load_cache():
    try:
        with open(CACHE_FILE, encoding="utf-8") as f:
            data = json.load(f)
        return data.get("rows", []), float(data.get("ts", 0))
    except (OSError, ValueError):
        return [], 0.0


def _save_cache(rows):
    try:
        os.makedirs(os.path.dirname(CACHE_FILE), exist_ok=True)
        with open(CACHE_FILE, "w", encoding="utf-8") as f:
            json.dump({"ts": time.time(), "rows": rows}, f)
    except OSError as exc:
        log("cache write failed: %s" % exc)


def _live_scan():
    run(["nmcli", "device", "wifi", "rescan"], timeout=25)
    time.sleep(5)
    _, out, _ = run(["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY",
                     "device", "wifi", "list"])
    own = ap_ssid()
    rows, seen = [], set()
    for line in out.splitlines():
        f = terse_split(line)
        if len(f) < 4 or not f[1] or f[1] in seen or f[1] == own:
            continue
        seen.add(f[1])
        try:
            sig = int(f[2])
        except ValueError:
            sig = 0
        rows.append({
            "ssid": f[1],
            "signal": sig,
            "security": ":".join(x for x in f[3:] if x) or "--",
        })
    rows.sort(key=lambda r: -r["signal"])
    return rows


def station_connected():
    """AP 模式下是否已经有客户端连着（有客户端时绝不能拆热点去扫描）。"""
    rc, out, _ = run(["iw", "dev", "wlan0", "station", "dump"], timeout=10)
    return rc == 0 and "Station" in out


def uptime_seconds():
    try:
        with open("/proc/uptime", encoding="ascii") as f:
            return float(f.read().split()[0])
    except (OSError, ValueError):
        return 1e9


def sta_profiles():
    """已知的、允许自动连接的 WiFi 客户端配置（不含热点），按优先级从高到低。"""
    rc, out, _ = run(["nmcli", "-t", "-f", "NAME,TYPE,AUTOCONNECT,AUTOCONNECT-PRIORITY",
                      "con", "show"])
    if rc != 0:
        return []
    rows = []
    for line in out.splitlines():
        f = terse_split(line)
        if len(f) < 4:
            continue
        name, ctype = f[0], f[1]
        if ctype != "802-11-wireless" or not name or name == AP_CON:
            continue
        if f[2].strip() != "yes":
            continue
        try:
            prio = int(f[3])
        except ValueError:
            prio = 0
        rows.append((prio, name))
    rows.sort(key=lambda r: -r[0])
    return [n for _, n in rows]


def try_known_wifi():
    """依次尝试已知 WiFi 配置。成功返回 True。

    开机时 NetworkManager 自己也会连，这里是兜底（比如 NM 连失败过一次）。
    """
    for name in sta_profiles():
        log("trying known wifi profile %r" % name)
        rc, out, err = run(["nmcli", "con", "up", name], timeout=60)
        if rc == 0:
            log("known wifi %r connected" % name)
            return True
        log("known wifi %r failed rc=%s: %s" % (name, rc, (out + err).strip()[:200]))
    return False


def scan_with_retries(attempts=3, gap=8, min_ok=5):
    """扫一次往往因为射频刚起来而结果很少，多试几次取最好的。"""
    best = []
    for attempt in range(attempts):
        try:
            rows = _live_scan()
        except Exception as exc:                                # noqa: BLE001
            log("live scan failed: %s" % exc)
            rows = []
        if len(rows) > len(best):
            best = rows
        if len(best) >= min_ok:
            break
        if attempt + 1 < attempts:
            log("scan thin (%d nets), retrying in %ds" % (len(best), gap))
            time.sleep(gap)
    return best


def scan_networks(force=False):
    """返回 (rows, from_cache)。AP 模式下扫不到东西时退回磁盘缓存。"""
    with _scan_lock:
        if not force and time.time() - _scan_cache["ts"] < SCAN_TTL:
            return _scan_cache["rows"], _scan_cache["from_cache"]

        rows = scan_with_retries(attempts=3 if force else 1)

        if rows:
            _scan_cache.update(ts=time.time(), rows=rows, from_cache=False)
            _save_cache(rows)
            log("scan ok: %d networks (cached to disk)" % len(rows))
        else:
            rows, ts = _load_cache()
            _scan_cache.update(ts=ts, rows=rows, from_cache=True)
            if rows:
                log("live scan empty (AP mode?) -> using cache, %d networks" % len(rows))
        return _scan_cache["rows"], _scan_cache["from_cache"]


def find_profile_by_ssid(ssid):
    """找已有的同 SSID 配置，避免每次配网都新建一份。"""
    rc, out, _ = run(["nmcli", "-t", "-f", "NAME,TYPE", "con", "show"])
    if rc != 0:
        return None
    for line in out.splitlines():
        name, _, ctype = line.partition(":")
        if ctype != "802-11-wireless" or not name or name == AP_CON:
            continue
        rc2, cur, _ = run(["nmcli", "-g", "802-11-wireless.ssid", "con", "show", name])
        if rc2 == 0 and cur.strip() == ssid:
            return name
    return None


def security_of(ssid):
    """从扫描缓存里查这个 SSID 的加密方式，查不到返回 None。"""
    for row in _scan_cache["rows"]:
        if row["ssid"] == ssid:
            return row["security"]
    return None


def connect_wifi(ssid, password, hidden=False):
    """不依赖扫描结果：直接建/改连接配置再 up。

    AP 模式下 wcn36xx 无法扫描，用 `nmcli device wifi connect <ssid>`
    会报 "No network with SSID ... found"，所以必须走这条路。
    """
    if not password:
        sec = security_of(ssid)
        if sec and any(x in sec.upper() for x in ("WPA", "WEP", "WPA2", "WPA3")):
            return 4, ("这个网络需要密码（扫描显示加密方式为 %s），请填写密码后重试。"
                       % sec)

    name = find_profile_by_ssid(ssid)
    created = False
    if not name:
        name = "hf310-" + "".join(
            c if (c.isalnum() or c in "_.-") else "_" for c in ssid)[:32]
        rc, out, err = run(["nmcli", "con", "add", "type", "wifi",
                            "ifname", "wlan0", "con-name", name, "ssid", ssid])
        if rc != 0:
            return rc, (out + err).strip()
        created = True

    if password:
        rc, out, err = run(["nmcli", "con", "modify", name,
                            "wifi-sec.key-mgmt", "wpa-psk",
                            "wifi-sec.psk", password])
    else:
        rc, out, err = run(["nmcli", "con", "modify", name,
                            "wifi-sec.key-mgmt", "none"])
    if rc != 0:
        return rc, (out + err).strip()

    if hidden:
        run(["nmcli", "con", "modify", name, "802-11-wireless.hidden", "yes"])
    # 关键：明确写盘 autoconnect=yes，否则重启后不会自己连
    run(["nmcli", "con", "modify", name,
         "connection.autoconnect", "yes",
         "connection.autoconnect-priority", "50"])
    if password:
        # 密码存到系统侧（而不是等 secret agent 提供），重启后仍然可用
        run(["nmcli", "con", "modify", name, "wifi-sec.psk-flags", "0"])

    rc, out, err = run(["nmcli", "con", "up", name], timeout=120)
    if rc != 0 and created:
        run(["nmcli", "con", "delete", name])
    return rc, (out + err).strip()


